# Copy to .env.local and fill in your Firebase web app config.
# Without these, the app runs in OFFLINE single-player mode.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Local testing with the Firebase emulators (firebase emulators:start):
# set to 1 and provide any non-empty PROJECT_ID + DATABASE_URL above.
NEXT_PUBLIC_FIREBASE_EMULATOR=0
